# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# --- Secrets ----------------------------------------------------------------
.env

# --- Corpus + index artefacts (regenerate with `python -m ingest.fetch`) -----
# The RUNTIME needs the built artefacts present on a fresh clone, because a
# Render free-tier instance has an ephemeral disk - anything built at runtime
# (model download, chunk/embed/store outputs) is lost on sleep, so a woken
# instance would hit "collection does not exist" on the first question. The
# built artefacts are tiny (~3 MB), so they are committed to the image and
# gitignored only for the bulky, regenerable intermediates.
data/raw/
data/quarantine.jsonl

# Keep the committed evidence files, ignore the bulky regenerable ones
!data/*.md
!data/source_snapshot.json

# --- Model cache ------------------------------------------------------------
.cache/
models/*
!models/all-MiniLM-L6-v2/
!models/all-MiniLM-L6-v2/**

# --- Editors / OS -----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
