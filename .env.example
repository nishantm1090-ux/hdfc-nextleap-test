# ===========================================================================
#  .env.example  --  TEMPLATE. Copy to `.env` and fill in.
#  `cp .env.example .env`   (PowerShell: `Copy-Item .env.example .env`)
#
#  `.env` holds real API keys and is in `.gitignore`. This file holds no
#  secrets and IS committed. Never put a working key here.
#
#  Every value is OPTIONAL. The app runs fully offline on `LLM_PROVIDER=stub`
#  (extractive answers, no network, no key) with everything else unset.
# ===========================================================================

# --- Which provider ---------------------------------------------------------
#   stub    extractive, no network, no key. THE DEFAULT, and what the test
#           suite is pinned to.
#   groq    fast hosted open models - cheapest way to see generated prose.
#   ollama  local Ollama server.
#   openai  any OpenAI-compatible endpoint (also covers Groq/Together/
#           OpenRouter if you set OPENAI_BASE_URL instead).
#
# An LLM_PROVIDER set in your real shell environment overrides this file.
LLM_PROVIDER=stub

# --- Groq -------------------------------------------------------------------
# Key:  https://console.groq.com/keys
# Model: any id from https://console.groq.com/docs/models
# Read only when LLM_PROVIDER=groq.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- Ollama -----------------------------------------------------------------
# Read only when LLM_PROVIDER=ollama. Needs the Ollama app running locally.
OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3.1:8b

# --- OpenAI / any OpenAI-compatible endpoint --------------------------------
# Read only when LLM_PROVIDER=openai.
OPENAI_API_KEY=
# Leave blank for OpenAI itself. Set it to point the same code at another host:
#   https://api.groq.com/openai/v1
#   https://api.together.xyz/v1
#   https://openrouter.ai/api/v1
OPENAI_BASE_URL=

# --- Model download ---------------------------------------------------------
# all-MiniLM-L6-v2 is pulled from HuggingFace on the first run (~90MB) and then
# cached, after which the pipeline is fully offline. Leave blank to use the
# default cache location; set it only to move the cache.
HF_HOME=
